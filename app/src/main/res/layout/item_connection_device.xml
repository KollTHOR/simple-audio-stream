<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/card_connection_device"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    app:cardCornerRadius="12dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/card_stroke"
    app:strokeWidth="1dp"
    app:cardBackgroundColor="@color/input_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp">

        <!-- Top Row: Icon, Device Name, Badges, Connect/Disconnect Button -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Device Icon Frame -->
            <FrameLayout
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_stat_badge"
                android:layout_marginEnd="10dp">

                <ImageView
                    android:id="@+id/iv_device_icon"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_receiver"
                    app:tint="@color/primary" />
            </FrameLayout>

            <!-- Device Name & Dot -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/tv_device_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Receiver Node"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary"
                        android:maxLines="1"
                        android:ellipsize="end" />

                    <!-- Active Dot Indicator -->
                    <View
                        android:id="@+id/view_active_dot"
                        android:layout_width="6dp"
                        android:layout_height="6dp"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/bg_badge"
                        android:backgroundTint="@color/status_green"
                        android:visibility="gone" />

                    <!-- Badges Container -->
                    <LinearLayout
                        android:id="@+id/layout_device_badges"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginStart="6dp"
                        android:gravity="center_vertical">

                        <!-- Primary Transport Badge -->
                        <TextView
                            android:id="@+id/tv_device_transport_badge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="LAN"
                            android:textSize="9sp"
                            android:textStyle="bold"
                            android:textColor="@color/pill_text"
                            android:background="@drawable/bg_stat_badge"
                            android:paddingStart="5dp"
                            android:paddingEnd="5dp"
                            android:paddingTop="1dp"
                            android:paddingBottom="1dp" />

                        <!-- Secondary Method Badge -->
                        <TextView
                            android:id="@+id/tv_badge_secondary"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:text="BLE"
                            android:textSize="9sp"
                            android:textStyle="bold"
                            android:textColor="@color/status_blue"
                            android:background="@drawable/bg_stat_badge"
                            android:paddingStart="5dp"
                            android:paddingEnd="5dp"
                            android:paddingTop="1dp"
                            android:paddingBottom="1dp"
                            android:visibility="gone" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:id="@+id/tv_device_details"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="192.168.1.50 • Local Wi-Fi"
                    android:textSize="11sp"
                    android:textColor="@color/text_secondary"
                    android:maxLines="3"
                    android:lineSpacingExtra="1dp"
                    android:ellipsize="end"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <!-- Action Button Container -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginStart="6dp">

                <!-- Disconnect Button (Shown when connected) -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_device_disconnect"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:minHeight="0dp"
                    android:minWidth="0dp"
                    android:paddingLeft="10dp"
                    android:paddingRight="10dp"
                    android:paddingTop="0dp"
                    android:paddingBottom="0dp"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="@color/status_red"
                    app:strokeColor="@color/status_red"
                    app:strokeWidth="1dp"
                    app:cornerRadius="8dp"
                    android:text="Disconnect"
                    android:visibility="gone" />

                <!-- Connect Button (Shown when available) -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_device_connect"
                    style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:minHeight="0dp"
                    android:minWidth="0dp"
                    android:paddingLeft="12dp"
                    android:paddingRight="12dp"
                    android:paddingTop="0dp"
                    android:paddingBottom="0dp"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:backgroundTint="@color/primary"
                    android:textColor="@color/white"
                    app:cornerRadius="8dp"
                    android:text="Connect" />
            </LinearLayout>
        </LinearLayout>

        <!-- Dedicated Per-Receiver Volume Control Row (Multi-Receiver Fan-Out) -->
        <LinearLayout
            android:id="@+id/layout_device_volume"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_stat_badge"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:visibility="gone">

            <!-- Mute/Unmute Toggle Button -->
            <ImageView
                android:id="@+id/btn_device_mute"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_volume_up"
                app:tint="@color/primary"
                android:clickable="true"
                android:focusable="true"
                android:layout_marginEnd="6dp" />

            <com.google.android.material.slider.Slider
                android:id="@+id/slider_device_vol"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:valueFrom="0.0"
                android:valueTo="100.0"
                android:stepSize="1.0"
                android:value="100.0"
                app:thumbColor="@color/primary"
                app:trackColorActive="@color/primary"
                app:trackColorInactive="#2A2A38"
                app:trackHeight="4dp"
                app:thumbWidth="14dp"
                app:thumbHeight="14dp"
                app:thumbRadius="7dp"
                app:haloRadius="14dp" />

            <!-- Volume Percent Label -->
            <TextView
                android:id="@+id/tv_device_vol_val"
                android:layout_width="36dp"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:text="100%"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="@color/primary"
                android:layout_marginStart="4dp" />
        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
