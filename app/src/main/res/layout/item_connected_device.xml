<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/card_connected_device"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="6dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    app:cardCornerRadius="10dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/card_stroke"
    app:strokeWidth="1dp"
    app:cardBackgroundColor="@color/input_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <!-- Collapsed Header Row: Title (Device Name) + Status Dot + Chevron -->
        <LinearLayout
            android:id="@+id/layout_connected_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tv_device_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Xiaomi Pad 8 Pro"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:maxLines="1"
                android:ellipsize="end" />

            <!-- Active Connection Dot Indicator -->
            <View
                android:id="@+id/view_active_dot"
                android:layout_width="7dp"
                android:layout_height="7dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_badge"
                android:backgroundTint="@color/status_green" />

            <ImageView
                android:id="@+id/iv_connected_chevron"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginStart="6dp"
                android:src="@drawable/ic_chevron_right"
                android:rotation="0"
                app:tint="@color/text_hint" />
        </LinearLayout>

        <!-- Simple Thin Volume Slider (Always Visible in Collapsed State) -->
        <LinearLayout
            android:id="@+id/layout_device_volume"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="2dp">

            <ImageView
                android:id="@+id/btn_device_mute"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_volume_up"
                app:tint="@color/primary"
                android:clickable="true"
                android:focusable="true"
                android:layout_marginEnd="4dp" />

            <com.google.android.material.slider.Slider
                android:id="@+id/slider_device_vol"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:valueFrom="0.0"
                android:valueTo="100.0"
                android:stepSize="1.0"
                android:value="100.0"
                app:thumbColor="@color/primary"
                app:trackColorActive="@color/primary"
                app:trackColorInactive="#2A2A38"
                app:thumbRadius="5dp"
                app:trackHeight="3dp" />

            <TextView
                android:id="@+id/tv_device_vol_val"
                android:layout_width="32dp"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:text="100%"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="@color/primary"
                android:layout_marginStart="2dp" />
        </LinearLayout>

        <!-- Expandable Details Section (Transport & Disconnect button) -->
        <LinearLayout
            android:id="@+id/layout_connected_expanded_details"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="4dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/tv_device_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Connected • Local Wi-Fi"
                android:textSize="11sp"
                android:textColor="@color/text_secondary"
                android:maxLines="1"
                android:ellipsize="end" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_device_disconnect"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="34dp"
                android:minHeight="0dp"
                android:layout_marginTop="6dp"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="@color/status_red"
                app:strokeColor="@color/status_red"
                app:strokeWidth="1dp"
                app:cornerRadius="6dp"
                android:text="Disconnect" />
        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
