<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/card_connected_device"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/card_stroke"
    app:strokeWidth="1dp"
    app:cardBackgroundColor="@color/input_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp">

        <!-- Header Row: Title (Device Name) + Status Dot -->
        <LinearLayout
            android:id="@+id/layout_connected_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_device_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Xiaomi Pad 8 Pro"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/tv_device_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Connected • Local Wi-Fi"
                    android:textSize="11sp"
                    android:textColor="@color/text_secondary"
                    android:layout_marginTop="2dp"
                    android:maxLines="1"
                    android:ellipsize="end" />
            </LinearLayout>

            <!-- Active Connection Dot Indicator -->
            <View
                android:id="@+id/view_active_dot"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_badge"
                android:backgroundTint="@color/status_green" />
        </LinearLayout>

        <!-- Volume Slider (Transmitter Only, Gone on Receiver) -->
        <LinearLayout
            android:id="@+id/layout_device_volume"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="6dp">

            <ImageView
                android:id="@+id/btn_device_mute"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_volume_up"
                app:tint="@color/primary"
                android:clickable="true"
                android:focusable="true"
                android:layout_marginEnd="6dp" />

            <com.google.android.material.slider.Slider
                android:id="@+id/slider_device_vol"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:valueFrom="0.0"
                android:valueTo="100.0"
                android:stepSize="1.0"
                android:value="100.0"
                app:thumbColor="@color/primary"
                app:trackColorActive="@color/primary"
                app:trackColorInactive="#2A2A38"
                app:trackHeight="4dp"
                app:thumbWidth="14dp"
                app:thumbHeight="14dp"
                app:thumbRadius="7dp"
                app:haloRadius="14dp" />

            <TextView
                android:id="@+id/tv_device_vol_val"
                android:layout_width="34dp"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:text="100%"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="@color/primary"
                android:layout_marginStart="4dp" />
        </LinearLayout>

        <!-- Always Visible Action Buttons: Save + Disconnect -->
        <LinearLayout
            android:id="@+id/layout_connected_actions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_device_save"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:minHeight="0dp"
                android:layout_marginEnd="8dp"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/primary"
                app:strokeColor="@color/primary"
                app:strokeWidth="1dp"
                app:cornerRadius="8dp"
                android:text="Save Device" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_device_disconnect"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:minHeight="0dp"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/status_red"
                app:strokeColor="@color/status_red"
                app:strokeWidth="1dp"
                app:cornerRadius="8dp"
                android:text="Disconnect" />
        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
