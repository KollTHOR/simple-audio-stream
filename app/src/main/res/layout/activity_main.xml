<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="@color/bg_screen">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:paddingBottom="88dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxWidth="@dimen/content_max_width"
                android:orientation="vertical"
                android:padding="@dimen/screen_padding">

                <!-- Top Header with IP Pill -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="@dimen/card_spacing">

                    <TextView
                        android:id="@+id/tv_title"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/app_name"
                        android:textSize="@dimen/title_text_size"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary" />

                    <!-- Clickable IP Pill -->
                    <LinearLayout
                        android:id="@+id/layout_ip_pill"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:background="@drawable/bg_ip_pill"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:paddingTop="6dp"
                        android:paddingBottom="6dp"
                        android:clickable="true"
                        android:focusable="true">

                        <ImageView
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:src="@drawable/ic_wifi"
                            android:layout_marginEnd="6dp"
                            app:tint="@color/pill_text" />

                        <TextView
                            android:id="@+id/tv_header_ip"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Detecting IP..."
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:textColor="@color/pill_text" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Mode Selector (Material Segmented Control) -->
                <com.google.android.material.button.MaterialButtonToggleGroup
                    android:id="@+id/toggle_mode_group"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/toggle_height"
                    android:layout_marginBottom="@dimen/card_spacing"
                    app:singleSelection="true"
                    app:selectionRequired="true"
                    app:checkedButton="@+id/btn_mode_transmitter">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_mode_transmitter"
                        style="?attr/materialButtonOutlinedStyle"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:text="@string/mode_transmitter"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary"
                        app:strokeColor="@color/card_stroke"
                        app:icon="@drawable/ic_transmitter"
                        app:iconTint="@color/text_primary"
                        app:iconGravity="textStart"
                        app:iconPadding="6dp"
                        app:iconSize="18dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_mode_receiver"
                        style="?attr/materialButtonOutlinedStyle"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:text="@string/mode_receiver"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary"
                        app:strokeColor="@color/card_stroke"
                        app:icon="@drawable/ic_receiver"
                        app:iconTint="@color/text_primary"
                        app:iconGravity="textStart"
                        app:iconPadding="6dp"
                        app:iconSize="18dp" />
                </com.google.android.material.button.MaterialButtonToggleGroup>

                <!-- Configuration & Action Card -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_config"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/card_spacing"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="1dp"
                    app:strokeColor="@color/card_stroke"
                    app:strokeWidth="1dp"
                    app:cardBackgroundColor="@color/card_bg">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/card_inner_padding">

                        <TextView
                            android:id="@+id/tv_mode_guide"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Stream this device's audio over local Wi-Fi"
                            android:textSize="13sp"
                            android:textColor="@color/text_secondary"
                            android:layout_marginBottom="12dp" />

                        <!-- Target IP Input (Transmitter Only) -->
                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/til_target_ip"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="10dp"
                            android:hint="@string/target_ip_hint"
                            android:textColorHint="@color/text_hint"
                            app:hintTextColor="@color/primary"
                            app:boxBackgroundColor="@color/input_bg"
                            app:boxStrokeColor="@color/primary"
                            app:boxCornerRadiusBottomEnd="8dp"
                            app:boxCornerRadiusBottomStart="8dp"
                            app:boxCornerRadiusTopEnd="8dp"
                            app:boxCornerRadiusTopStart="8dp"
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/et_target_ip"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="textUri"
                                android:textSize="14sp"
                                android:textColor="@color/text_primary"
                                android:textColorHint="@color/text_hint"
                                android:text="192.168.1.255" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <!-- Port Input -->
                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/til_port"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="12dp"
                            android:hint="@string/port_hint"
                            android:textColorHint="@color/text_hint"
                            app:hintTextColor="@color/primary"
                            app:boxBackgroundColor="@color/input_bg"
                            app:boxStrokeColor="@color/primary"
                            app:boxCornerRadiusBottomEnd="8dp"
                            app:boxCornerRadiusBottomStart="8dp"
                            app:boxCornerRadiusTopEnd="8dp"
                            app:boxCornerRadiusTopStart="8dp"
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/et_port"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="number"
                                android:textSize="14sp"
                                android:textColor="@color/text_primary"
                                android:textColorHint="@color/text_hint"
                                android:text="50005" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <!-- Remote Volume Section (Transmitter Only) -->
                        <LinearLayout
                            android:id="@+id/layout_volume_control"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:background="@color/input_bg"
                            android:padding="10dp"
                            android:layout_marginBottom="14dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center_vertical"
                                android:layout_marginBottom="4dp">

                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="DAP REMOTE VOLUME"
                                    android:textSize="11sp"
                                    android:textStyle="bold"
                                    android:textColor="@color/text_hint"
                                    android:letterSpacing="0.05" />

                                <TextView
                                    android:id="@+id/tv_remote_vol_label"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="100%"
                                    android:textSize="12sp"
                                    android:textStyle="bold"
                                    android:textColor="@color/primary" />
                            </LinearLayout>

                            <!-- Volume Slider -->
                            <com.google.android.material.slider.Slider
                                android:id="@+id/slider_remote_vol"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:valueFrom="0.0"
                                android:valueTo="100.0"
                                android:stepSize="1.0"
                                android:value="100.0"
                                app:thumbColor="@color/primary"
                                app:trackColorActive="@color/primary"
                                app:trackColorInactive="#2A2A38" />
                        </LinearLayout>

                        <!-- Action Button -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_action"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/btn_height"
                            android:text="@string/start_stream"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:textColor="@color/white"
                            app:cornerRadius="10dp"
                            app:icon="@drawable/ic_play"
                            app:iconTint="@color/white"
                            app:iconGravity="textStart"
                            app:iconPadding="8dp"
                            app:iconSize="20dp" />

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Live Monitor / Telemetry Card -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_telemetry"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="1dp"
                    app:strokeColor="@color/card_stroke"
                    app:strokeWidth="1dp"
                    app:cardBackgroundColor="@color/card_bg">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/card_inner_padding">

                        <!-- Monitor Header + Status Badge -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="8dp">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="STREAM MONITOR"
                                android:textSize="11sp"
                                android:textStyle="bold"
                                android:textColor="@color/text_hint"
                                android:letterSpacing="0.05" />

                            <TextView
                                android:id="@+id/tv_badge_status"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="IDLE"
                                android:textSize="10sp"
                                android:textStyle="bold"
                                android:paddingStart="8dp"
                                android:paddingEnd="8dp"
                                android:paddingTop="3dp"
                                android:paddingBottom="3dp"
                                android:textColor="@color/white"
                                android:background="@drawable/bg_badge"
                                android:backgroundTint="@color/status_gray" />
                        </LinearLayout>

                        <!-- Endpoint Target/Sender Info -->
                        <TextView
                            android:id="@+id/tv_endpoint_info"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Not connected"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:textColor="@color/text_primary"
                            android:layout_marginBottom="3dp" />

                        <!-- Packets and Data Rate -->
                        <TextView
                            android:id="@+id/tv_packets_stat"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Packets: 0 (0 pkts/s • 0 KB/s)"
                            android:textSize="12sp"
                            android:textColor="@color/text_secondary"
                            android:layout_marginBottom="10dp" />

                        <!-- Live VU Meter Section -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="4dp">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Audio Signal"
                                android:textSize="11sp"
                                android:textColor="@color/text_secondary" />

                            <TextView
                                android:id="@+id/tv_audio_level_val"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0%"
                                android:textSize="11sp"
                                android:textStyle="bold"
                                android:textColor="@color/text_primary" />
                        </LinearLayout>

                        <ProgressBar
                            android:id="@+id/pb_audio_level"
                            style="?android:attr/progressBarStyleHorizontal"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/progress_height"
                            android:max="100"
                            android:progress="0"
                            android:progressBackgroundTint="#272732"
                            android:progressTint="@color/status_green"
                            android:layout_marginBottom="10dp" />

                        <!-- Audio Pipeline & Buffer Monitor -->
                        <LinearLayout
                            android:id="@+id/layout_pipeline_details"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:background="@color/input_bg"
                            android:padding="10dp"
                            android:layout_marginBottom="10dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center_vertical"
                                android:layout_marginBottom="4dp">

                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="AUDIO PIPELINE"
                                    android:textSize="11sp"
                                    android:textStyle="bold"
                                    android:textColor="@color/text_hint"
                                    android:letterSpacing="0.05" />

                                <TextView
                                    android:id="@+id/tv_pipeline_profile"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Music Mode"
                                    android:textSize="10sp"
                                    android:textStyle="bold"
                                    android:paddingStart="6dp"
                                    android:paddingEnd="6dp"
                                    android:paddingTop="2dp"
                                    android:paddingBottom="2dp"
                                    android:textColor="@color/primary"
                                    android:background="@drawable/bg_badge"
                                    android:backgroundTint="#242436" />
                            </LinearLayout>

                            <TextView
                                android:id="@+id/tv_pipeline_format"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="48.0 kHz • 16-bit Stereo PCM • 1536 kbps"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                android:textColor="@color/text_primary"
                                android:layout_marginBottom="6dp" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center_vertical"
                                android:layout_marginBottom="4dp">

                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="Jitter Buffer Health"
                                    android:textSize="11sp"
                                    android:textColor="@color/text_secondary" />

                                <TextView
                                    android:id="@+id/tv_buffer_health_val"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="0% (0 slots)"
                                    android:textSize="11sp"
                                    android:textStyle="bold"
                                    android:textColor="@color/primary" />
                            </LinearLayout>

                            <ProgressBar
                                android:id="@+id/pb_buffer_health"
                                style="?android:attr/progressBarStyleHorizontal"
                                android:layout_width="match_parent"
                                android:layout_height="@dimen/progress_height"
                                android:max="100"
                                android:progress="0"
                                android:progressBackgroundTint="#272732"
                                android:progressTint="@color/primary" />
                        </LinearLayout>

                        <!-- Diagnostic Hint -->
                        <TextView
                            android:id="@+id/tv_diagnostic_tip"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Select mode and start streaming."
                            android:textSize="12sp"
                            android:textColor="@color/text_secondary"
                            android:lineSpacingMultiplier="1.15" />

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- Settings Button at Bottom Right -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fab_settings"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        app:srcCompat="@drawable/ic_settings"
        app:tint="@color/white"
        app:backgroundTint="@color/card_bg"
        app:rippleColor="@color/primary"
        app:borderWidth="1dp"
        app:elevation="4dp"
        android:contentDescription="Settings" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
