# Release Signing Configuration Template
# Copy this file to 'keystore.properties' (which is gitignored) and fill in your private signing credentials.
#
# Alternatively, configure via environment variables:
#   RELEASE_KEYSTORE_PATH, RELEASE_KEYSTORE_PASSWORD,
#   RELEASE_KEY_ALIAS, RELEASE_KEY_PASSWORD
# or via local.properties (which is also gitignored).
#
# NEVER commit keystore.properties or private keystore files to source control.

releaseKeystorePath=/path/to/your/release.keystore
releaseKeystorePassword=your_keystore_password
releaseKeyAlias=your_key_alias
releaseKeyPassword=your_key_password
